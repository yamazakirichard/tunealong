# Songbook settings. Copy to .env and change what you need:
#   cp .env.example .env && docker compose up -d
# Every value below is the default; leaving a line out (or blank) keeps it.

# --- where things live ---------------------------------------------------------
# Data directory on the host: songbook.sqlite, originals/ (MeTube downloads and
# imports), renders/ (disposable cache) and metube-state/.
SONGBOOK_DATA=./data
# User and group that own everything written under SONGBOOK_DATA, for all three
# containers (MeTube reads the same PUID/PGID). Use your own: `id -u`, `id -g`.
# (A PUID/PGID already exported in your shell overrides these.)
PUID=1000
PGID=1000

# --- network --------------------------------------------------------------------------
# Only the api publishes a port. Set SONGBOOK_BIND=127.0.0.1 to reach it only
# from this machine (e.g. when a reverse proxy runs here too).
SONGBOOK_PORT=8080
SONGBOOK_BIND=0.0.0.0
# Serve under a subpath, e.g. /songbook, when a reverse proxy forwards
# https://example.com/songbook/ to this container without stripping the
# prefix. Read at runtime; no rebuild needed. Blank = served at /.
SONGBOOK_BASE_PATH=

# --- optional built-in login (HTTP Basic) ---------------------------------------
# Off unless BOTH are set. Leave them blank if a reverse proxy or SSO already
# protects Songbook. /api/health always stays open for healthchecks.
# Make a bcrypt hash with:
#   docker run --rm songbook:latest python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
# !! Write every $ in the hash as $$ here, or Compose's variable interpolation
# !! mangles it:  $2b$12$abc...  becomes  $$2b$$12$$abc...
SONGBOOK_AUTH_USER=
SONGBOOK_AUTH_PASSWORD_HASH=

# --- MeTube ------------------------------------------------------------------------
# The bundled MeTube service. To use a MeTube you already run instead, point
# this at it (see "Using an existing MeTube" in the README).
METUBE_URL=http://metube:8081
METUBE_VERSION=2026.09.26

# --- worker ------------------------------------------------------------------------------
# Render cache budget in GB, checked hourly; least-used renders go first.
# Originals are never deleted.
SONGBOOK_CACHE_MAX_GB=20
# Give up on a download after this many seconds (per attempt; 3 attempts).
SONGBOOK_DOWNLOAD_TIMEOUT_S=900
# How often the library folder is rescanned for files added by hand.
SONGBOOK_SCAN_INTERVAL_S=300

# --- image --------------------------------------------------------------------------------
# Built locally by `docker compose up` (or `docker compose build`).
SONGBOOK_IMAGE=songbook:latest
